{
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "css": ["styles.css"],
      "js": ["content.js"],
      "matches": ["https://chat.openai.com/*", "https://chatgpt.com/*"]
    }
  ],
  "description": "A plugin to connect ChatGPT to Mendo",
  "host_permissions": ["*://chat.openai.com/*", "*://chatgpt.com/*"],
  "icons": {
    "128": "assets/logo.png"
  },
  "key": "",
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "name": "Mendo GPT",
  "optional_permissions": [],
  "permissions": [
    "activeTab",
    "storage",
    "sidePanel",
    "background",
    "notifications",
    "alarms",
    "windows",
    "contextMenus"
  ],
  "update_url": "https://clients2.google.com/service/update2/crx",
  "version": "1.4.30",
  "web_accessible_resources": [
    {
      "matches": ["https://chat.openai.com/*", "https://chatgpt.com/*"],
      "resources": [
        "assets/*.png",
        "content.js",
        "frame.html",
        "frame_relay.js"
      ]
    },
    {
      "matches": ["\u003Call_urls>"],
      "resources": ["assets/sounds/*.mp3"]
    }
  ]
}
